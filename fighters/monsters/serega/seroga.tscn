[node name="seroga" type="Node2D"]
script = ExtResource("1_seroga")
voice_sound = ExtResource("2_7wtle")
voice_pitch_min = 0.7
voice_pitch_max = 0.7
pre_attack_lines = ["Ты думал, я устал?
Я просто менял тональность.", "Эта мелодия...
Она никогда не заканчивается.", "Слышишь тишину?
Вот моя любимая нота.", "Каждая фальшивая нота -
это маленькая смерть.", "Музыка - это боль.
А боль - это я.", "Сыграй со мной.
Ты все равно проиграешь.", "Я написал эту песню
пока ты спал.", "Финальный аккорд
будет твоим.", "Устал?
Я только начинаю.", "Тишина - это тоже музыка.
Самая громкая."]
description = "  * Темный Серега смотрит в никуда.
  * Его музыка звучит откуда-то изнутри."
acts = Array[ExtResource("2_act")]([SubResource("Resource_act1"), SubResource("Resource_act2"), SubResource("Resource_act3")])
xp_bled = 0
money_dropped = 0
battle_music = "serega"
idle_lines = PackedStringArray("Он тихо напевает что-то под нос.", "Его пальцы отбивают ритм в воздухе.", "Он смотрит сквозь тебя.", "Где-то далеко играет музыка.", "Он устал. Но не останавливается.")
opening_line_singular = "Из темноты появляется Темный Серега."
title = "Темный Серега"
base_fighter_stats = Dictionary[int, int]({
0: 1200,
1: 10,
2: 4,
4: 1
})
