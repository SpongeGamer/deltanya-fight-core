script = ExtResource("1_nikita")
description = "Никита."
acts = Array[ExtResource("2_mshhk")]([SubResource("Resource_1ysc5"), SubResource("Resource_wu1k7"), SubResource("Resource_byhdc")])
battle_music = "nikita"
idle_lines = PackedStringArray("Продолжать занятие!", "Обычно люди спускают собак, а Я спущу Ксюху.", "Время Никитить!")
opening_line_singular = "  * Никита обучает."
title = "Никита"
base_fighter_stats = Dictionary[int, int]({
0: 400,
1: 1,
2: 10,
4: 1
})
main_sprite = NodePath("AnimatedSprite2D")

