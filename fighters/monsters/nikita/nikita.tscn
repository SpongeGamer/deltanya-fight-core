[sub_resource type="Resource" id="Resource_1ysc5"]
script = ExtResource("2_mshhk")
title = "Время Никиты"
text = "  * Вы выдали комментарии про аллегории.
  * Никита говорит вам про ремнант.
  * Щадить он вас не будет."
metadata/_custom_type_script = "uid://bwvvm6kvpsqi1"

[sub_resource type="Resource" id="Resource_wu1k7"]
script = ExtResource("2_mshhk")
title = "ЕШЬ ЧО ДОЮТ"
text = "  * Вы крикнули \"ЕШЬ ЧО ДОЮТ\"
  * Никита ответил тем же, но громче.
  * Щадить он вас не будет."
metadata/_custom_type_script = "uid://bwvvm6kvpsqi1"

[sub_resource type="Resource" id="Resource_byhdc"]
script = ExtResource("2_mshhk")
title = "Спросить"
text = "  * Вы спросили как у Никиты дела.
  * Не самое эффективное действие."
metadata/_custom_type_script = "uid://bwvvm6kvpsqi1"

