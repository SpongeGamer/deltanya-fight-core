speaker_name = "Егор"
speaker_img = SubResource("CompressedTexture2D_uo71y")
text = "Ты и так знаешь как сильно мы тебя ценим, и мы не устанем это говорить. Без тебя всего этого бы не было. Спасибо за все!"
