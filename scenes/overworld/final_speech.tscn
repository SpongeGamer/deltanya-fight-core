[sub_resource type="Resource" id="Resource_iwaue"]
script = ExtResource("3_c3mh6")
speaker_name = "Егор"
speaker_img = SubResource("CompressedTexture2D_f8p8i")
text = "Если серьезно - нам очень понравилось работать над этим проектом, для меня это было что-то новое и необычное."
