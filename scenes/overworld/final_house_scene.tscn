[sub_resource type="Resource" id="Resource_kklv2"]
script = ExtResource("33_o0dio")
speaker_name = "Макс"
speaker_img = SubResource("CompressedTexture2D_o0dio")
text = "Пусть вселенная слышит твои запросы громче, чем слушатели бас.
Как всегда незаменимого здоровья, ощущения счастья и сплошного позитива!"
text_speed = 12.0
text_sound = SubResource("AudioStreamOggVorbis_85sht")
text_volume_pitch_min = 1.0
text_volume_pitch_max = 1.0
metadata/_custom_type_script = "uid://dpl3myc5lbyaq"

[sub_resource type="Resource" id="Resource_dsuly"]
script = ExtResource("33_o0dio")
speaker_name = "Никита"
speaker_img = ExtResource("42_o2oq4")
text = "Ну и приключение выдалось, да?
Я рад что все хорошо и мы дома.
Пообщайся с друзьями, потом решим свои вопросы."
text_speed = 12.0
text_sound = ExtResource("43_kqe6t")
text_volume_pitch_min = 1.0
text_volume_pitch_max = 1.0
