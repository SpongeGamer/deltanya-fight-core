[sub_resource type="Resource" id="Resource_75sjc"]
script = ExtResource("15_5aqrf")
text = "Старый музыкальный автомат. 
На экране горит надпись: 
«Вставьте монету для проигрывания тишины». 
Вы решили сэкономить."
