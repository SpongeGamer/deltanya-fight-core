speaker_name = "Князь"
speaker_img = SubResource("CompressedTexture2D_ej7ld")
text = "Вы ищете [color=red]Темного Рыцаря[/color]. Думаете, это злобный тиран? Чудовище, пришедшее из внешнего космоса, чтобы расколоть ваш мир?"
