[sub_resource type="Resource" id="Resource_talk1"]
script = ExtResource("1_text")
speaker_name = "Князь"
speaker_img = ExtResource("5_portrait")
text = "Этот бар стоит здесь дольше, чем кто-либо помнит.
Даже я уже не помню, когда открыл его."
text_speed = 14.0
text_sound = ExtResource("7_voice")
text_volume_db = 4
text_volume_pitch_min = 0.9
text_volume_pitch_max = 0.9
metadata/_custom_type_script = "uid://dpl3myc5lbyaq"

[sub_resource type="Resource" id="Resource_talk2"]
script = ExtResource("1_text")
speaker_name = "Князь"
speaker_img = ExtResource("5_portrait")
text = "Знаете, сколько людей приходило сюда со своей болью?
Все они оставляли ее тут. Бар держит ее вместо них."
text_speed = 14.0
text_sound = ExtResource("7_voice")
text_volume_db = 4
text_volume_pitch_min = 0.9
text_volume_pitch_max = 0.9
metadata/_custom_type_script = "uid://dpl3myc5lbyaq"

[sub_resource type="Resource" id="Resource_topic_bar"]
script = ExtResource("4_topic")
label = "О баре"
dialogue = Array[ExtResource("3_de")]([SubResource("Resource_talk1"), SubResource("Resource_talk2")])
metadata/_custom_type_script = "uid://8orgtokfu828"

[sub_resource type="Resource" id="Resource_dark1"]
script = ExtResource("1_text")
speaker_name = "Князь"
speaker_img = ExtResource("5_portrait")
text = "Темный мир - это не обычное место. Это чье-то внутреннее состояние, которое стало слишком большим и обозленным."
text_speed = 13.0
text_sound = ExtResource("7_voice")
text_volume_db = 4
text_volume_pitch_min = 0.88
text_volume_pitch_max = 0.88
metadata/_custom_type_script = "uid://dpl3myc5lbyaq"

[sub_resource type="Resource" id="Resource_dark2"]
script = ExtResource("1_text")
speaker_name = "Князь"
speaker_img = ExtResource("5_portrait")
text = "Рыцарь - не злодей. Он просто... чья-то потерянная часть, что ищет дорогу домой."
text_speed = 13.0
text_sound = ExtResource("7_voice")
text_volume_db = 4
text_volume_pitch_min = 0.88
text_volume_pitch_max = 0.88
metadata/_custom_type_script = "uid://dpl3myc5lbyaq"

[sub_resource type="Resource" id="Resource_topic_dark"]
script = ExtResource("4_topic")
label = "О темном мире"
dialogue = Array[ExtResource("3_de")]([SubResource("Resource_dark1"), SubResource("Resource_dark2")])
metadata/_custom_type_script = "uid://8orgtokfu828"

[sub_resource type="Resource" id="Resource_kids1"]
script = ExtResource("1_text")
speaker_name = "Князь"
speaker_img = ExtResource("5_portrait")
text = "Дети не виноваты. Наш фонтан держал баланс светлого и темного.
Когда кому-то наверху стало совсем плохо - он треснул."
text_speed = 13.0
text_sound = ExtResource("7_voice")
text_volume_db = 4
text_volume_pitch_min = 0.88
text_volume_pitch_max = 0.88
metadata/_custom_type_script = "uid://dpl3myc5lbyaq"

[sub_resource type="Resource" id="Resource_kids2"]
script = ExtResource("1_text")
speaker_name = "Князь"
speaker_img = ExtResource("5_portrait")
text = "Они просто увидели щель и полезли.
Из любопытства. Из злости на свои подвалы и безпомощность. Вот и все."
text_speed = 13.0
text_sound = ExtResource("7_voice")
text_volume_db = 4
text_volume_pitch_min = 0.88
text_volume_pitch_max = 0.88
metadata/_custom_type_script = "uid://dpl3myc5lbyaq"

[sub_resource type="Resource" id="Resource_topic_kids"]
script = ExtResource("4_topic")
label = "О детях"
dialogue = Array[ExtResource("3_de")]([SubResource("Resource_kids1"), SubResource("Resource_kids2")])
metadata/_custom_type_script = "uid://8orgtokfu828"

[sub_resource type="Resource" id="Resource_knyaz1"]
script = ExtResource("1_text")
speaker_name = "Князь"
speaker_img = ExtResource("5_portrait")
text = "Я здесь потому что мне нравится здесь быть.
Или потому что больше некуда идти. Для меня это давно одно и то же."
text_speed = 14.0
text_sound = ExtResource("7_voice")
text_volume_db = 4
text_volume_pitch_min = 0.9
text_volume_pitch_max = 0.9
metadata/_custom_type_script = "uid://dpl3myc5lbyaq"

