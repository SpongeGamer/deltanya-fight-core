[sub_resource type="Resource" id="Resource_8fodd"]
script = ExtResource("13_d66av")
speaker_name = "Никита"
speaker_img = SubResource("CompressedTexture2D_6vxkf")
text = "Чувствую себя как в переходе у метро. Сейчас кто-нибудь начнет играть на саксофоне."
text_speed = 12.0
text_sound = SubResource("AudioStreamOggVorbis_m4ll7")
