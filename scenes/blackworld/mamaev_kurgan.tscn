[sub_resource type="Resource" id="Resource_6pioe"]
script = ExtResource("13_d66av")
speaker_name = "Катя"
speaker_img = SubResource("CompressedTexture2D_6uugr")
text = "Не накаркай. Хватит на сегодня боев."
text_speed = 16.0
text_sound = SubResource("AudioStreamOggVorbis_tecqy")
text_volume_db = 4
text_volume_pitch_min = 1.0
text_volume_pitch_max = 1.0
metadata/_custom_type_script = "uid://dpl3myc5lbyaq"

[sub_resource type="Resource" id="Resource_mrnf7"]
