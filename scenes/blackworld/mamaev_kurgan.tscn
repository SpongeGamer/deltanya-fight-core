text_volume_pitch_max = 1.0
metadata/_custom_type_script = "uid://dpl3myc5lbyaq"

[sub_resource type="Resource" id="Resource_nok4g"]
script = ExtResource("13_d66av")
speaker_name = "Никита"
speaker_img = SubResource("CompressedTexture2D_6vxkf")
text = "В целом и Мамаев Курган сам по себе длинный. От реальности не далеко все ушло."
text_speed = 12.0
text_sound = SubResource("AudioStreamOggVorbis_m4ll7")
text_volume_db = 4
text_volume_pitch_min = 1.0
text_volume_pitch_max = 1.0
metadata/_custom_type_script = "uid://dpl3myc5lbyaq"

