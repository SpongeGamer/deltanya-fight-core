[sub_resource type="Resource" id="Resource_wxfno"]
script = ExtResource("13_d66av")
speaker_name = "Егор"
speaker_img = SubResource("CompressedTexture2D_ie6bt")
text = "Вот интересно, кто это проектировал. \"А давайте сделаем коридор метров на двести, пусть побегают.\""
text_speed = 12.0
text_sound = SubResource("AudioStreamOggVorbis_5soo6")
