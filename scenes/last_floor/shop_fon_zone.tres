[sub_resource type="Resource" id="Resource_c0gob"]
script = ExtResource("1_h86yt")
text = "Фонтан - это второе сердце. Оно бьется неправильно и в целом оно не нужно этому миру."
text_speed = 17.0
text_sound = SubResource("AudioStreamOggVorbis_5eqfm")
text_volume_db = 4
