[sub_resource type="Resource" id="Resource_5yecv"]
script = ExtResource("1_h86yt")
text = "Тот, кто носит тьму внутри - не злой. Он... разбитый.
Все мы - простые и хрупкие вещи."
text_speed = 17.0
text_sound = SubResource("AudioStreamOggVorbis_gh6t8")
text_volume_db = 4
text_volume_pitch_min = 0.8
text_volume_pitch_max = 0.8
