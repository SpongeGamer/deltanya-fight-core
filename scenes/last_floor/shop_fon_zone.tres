[sub_resource type="AudioStreamOggVorbis" id="AudioStreamOggVorbis_7b4gm"]
packet_sequence = SubResource("OggPacketSequence_h67c6")

[sub_resource type="Resource" id="Resource_eogbh"]
script = ExtResource("1_h86yt")
text = "Меня зовут Фонит. Потому что я... фоню. Но иногда -  я все еще могу сыграть что-то чистое. Хочешь послушать? Нет? Жаль."
text_speed = 17.0
text_sound = SubResource("AudioStreamOggVorbis_7b4gm")
text_volume_db = 4
text_volume_pitch_min = 0.8
text_volume_pitch_max = 0.8
metadata/_custom_type_script = "uid://dpl3myc5lbyaq"

[sub_resource type="AudioStreamOggVorbis" id="AudioStreamOggVorbis_2i2y1"]
packet_sequence = SubResource("OggPacketSequence_h67c6")

[sub_resource type="Resource" id="Resource_7dryj"]
script = ExtResource("1_h86yt")
text = "Не верь тем, кто говорит, что знает путь. Тут все блуждают. Даже я. Особенно я."
text_speed = 17.0
text_sound = SubResource("AudioStreamOggVorbis_2i2y1")
text_volume_db = 4
text_volume_pitch_min = 0.8
text_volume_pitch_max = 0.8
metadata/_custom_type_script = "uid://dpl3myc5lbyaq"

[sub_resource type="AudioStreamOggVorbis" id="AudioStreamOggVorbis_kx0uh"]
packet_sequence = SubResource("OggPacketSequence_h67c6")

[sub_resource type="Resource" id="Resource_2i2y1"]
script = ExtResource("1_h86yt")
text = "Все, что ты видишь - чьи-то потерянные вещи. Кто-то потерял надежду, кто-то - память. А кто-то - просто кошелек."
text_speed = 17.0
text_sound = SubResource("AudioStreamOggVorbis_kx0uh")
text_volume_db = 4
text_volume_pitch_min = 0.8
text_volume_pitch_max = 0.8
metadata/_custom_type_script = "uid://dpl3myc5lbyaq"

