[sub_resource type="Resource" id="Resource_sh2sj"]
script = ExtResource("1_h86yt")
text = "Когда-то и меня вела дорога приключений..."
text_speed = 17.0
text_sound = SubResource("AudioStreamOggVorbis_ay6aq")
text_volume_db = 4
text_volume_pitch_min = 0.8
text_volume_pitch_max = 0.8
