[sub_resource type="Resource" id="Resource_fupcb"]
script = ExtResource("1_h86yt")
text = "Уходя, выключи свет. А, неважно. Тут его и так нет."
text_speed = 17.0
text_sound = SubResource("AudioStreamOggVorbis_kac6g")
text_volume_db = 4
text_volume_pitch_min = 0.8
text_volume_pitch_max = 0.8
