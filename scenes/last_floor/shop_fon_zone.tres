[sub_resource type="Resource" id="Resource_l3o76"]
script = ExtResource("1_h86yt")
text = "Я здесь давно. Настолько, что забыл, как звучит настоящая тишина. Все шипит, трещит... Но ты привыкаешь. Или сходишь с ума. Тут тонкая грань."
text_speed = 17.0
text_sound = SubResource("AudioStreamOggVorbis_c0gob")
text_volume_db = 4
text_volume_pitch_min = 0.8
