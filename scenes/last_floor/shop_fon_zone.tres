[sub_resource type="Resource" id="Resource_fajlw"]
script = ExtResource("1_h86yt")
text = "Хороший выбор. Эта вещь помогла пережить не одну бурю. Переживет и тебя."
text_speed = 17.0
text_sound = ExtResource("2_77vr4")
text_volume_db = 4
text_volume_pitch_min = 0.8
text_volume_pitch_max = 0.8
metadata/_custom_type_script = "uid://dpl3myc5lbyaq"

[sub_resource type="Resource" id="Resource_pfo5p"]
script = ExtResource("1_h86yt")
text = "Забирай. Мне эта вещь уже не нужна. А тебе - пригодится. Надеюсь."
text_speed = 17.0
text_sound = ExtResource("2_77vr4")
text_volume_db = 4
text_volume_pitch_min = 0.8
text_volume_pitch_max = 0.8
metadata/_custom_type_script = "uid://dpl3myc5lbyaq"

[sub_resource type="Resource" id="Resource_3dr30"]
script = ExtResource("1_h86yt")
text = "Пользуйся на здоровье. Оно тебе понадобится... дальше."
text_speed = 17.0
text_sound = ExtResource("2_77vr4")
text_volume_db = 4
text_volume_pitch_min = 0.8
text_volume_pitch_max = 0.8
metadata/_custom_type_script = "uid://dpl3myc5lbyaq"

[sub_resource type="Resource" id="Resource_d00uh"]
script = ExtResource("1_h86yt")
text = "Батарейки кончаются... О, покупатель. Быстро выбирай, пока я не вырубился."
text_speed = 17.0
text_sound = ExtResource("2_77vr4")
text_volume_db = 4
text_volume_pitch_min = 0.8
text_volume_pitch_max = 0.8
metadata/_custom_type_script = "uid://dpl3myc5lbyaq"

[sub_resource type="Resource" id="Resource_7hc37"]
script = ExtResource("1_h86yt")
text = "Редко кто сюда заходит. Обычно все бегут мимо. А ты зашел. Значит, есть что терять... или искать."
text_speed = 17.0
text_sound = ExtResource("2_77vr4")
text_volume_db = 4
text_volume_pitch_min = 0.8
text_volume_pitch_max = 0.8
metadata/_custom_type_script = "uid://dpl3myc5lbyaq"

[sub_resource type="Resource" id="Resource_sd061"]
script = ExtResource("1_h86yt")
text = "Фонит на связи."
text_speed = 17.0
text_sound = ExtResource("2_77vr4")
text_volume_db = 4
text_volume_pitch_min = 0.8
text_volume_pitch_max = 0.8
metadata/_custom_type_script = "uid://dpl3myc5lbyaq"

[sub_resource type="Resource" id="Resource_3q8r2"]
script = ExtResource("1_h86yt")
text = "Это тебя не спасло. Может, меня спасет. Или просто запылится."
text_speed = 17.0
text_sound = ExtResource("2_77vr4")
text_volume_db = 4
text_volume_pitch_min = 0.8
text_volume_pitch_max = 0.8
metadata/_custom_type_script = "uid://dpl3myc5lbyaq"

[sub_resource type="Resource" id="Resource_uj0b7"]
script = ExtResource("1_h86yt")
text = "Очень даже неплохой товар."
text_speed = 17.0
text_sound = ExtResource("2_77vr4")
text_volume_db = 4
text_volume_pitch_min = 0.8
text_volume_pitch_max = 0.8
metadata/_custom_type_script = "uid://dpl3myc5lbyaq"

[sub_resource type="Resource" id="Resource_aiucp"]
script = ExtResource("1_h86yt")
text = "Хорошая сделка - только здесь!"
text_speed = 17.0
text_sound = ExtResource("2_77vr4")
text_volume_db = 4
